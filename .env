```env
# ============================================================
# APPLICATION
# ============================================================

APP_NAME=5paisa Trading Dashboard
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000


# ============================================================
# 5PAISA XSTREAM AUTHENTICATION
# ============================================================

# App/User API Key
FIVEPAISA_APP_KEY=

# Vendor/User Key used for OAuth login
FIVEPAISA_VENDOR_KEY=

# 5paisa User ID
FIVEPAISA_USER_ID=

# Encryption key received with 5paisa API credentials
FIVEPAISA_ENCRYPTION_KEY=

# 5paisa Demat Client Code
FIVEPAISA_CLIENT_CODE=


# ============================================================
# OAUTH
# ============================================================

FIVEPAISA_OAUTH_URL=https://dev-openapi.5paisa.com/WebVendorLogin/VLogin/Index

FIVEPAISA_REDIRECT_URL=http://127.0.0.1:8000/api/5paisa/callback

FIVEPAISA_STATE=5paisa_dashboard


# ============================================================
# ACCESS TOKEN
# ============================================================

FIVEPAISA_ACCESS_TOKEN_URL=https://Openapi.5paisa.com/VendorsAPI/Service1.svc/GetAccessToken


# ============================================================
# MARKET DATA
# ============================================================

FIVEPAISA_API_BASE_URL=https://Openapi.5paisa.com

FIVEPAISA_MARKET_FEED_URL=https://Openapi.5paisa.com/VendorsAPI/Service1.svc/V1/MarketFeed

FIVEPAISA_MARKET_SNAPSHOT_URL=https://Openapi.5paisa.com/VendorsAPI/Service1.svc/MarketSnapshot

FIVEPAISA_HISTORICAL_URL=https://openapi.5paisa.com/V2/historical

FIVEPAISA_SCRIP_MASTER_URL=https://Openapi.5paisa.com/VendorsAPI/Service1.svc/ScripMaster/segment/all


# ============================================================
# WEBSOCKET
# ============================================================

WEBSOCKET_ENABLED=true

FIVEPAISA_WEBSOCKET_URL=wss://openfeed.5paisa.com/feeds/api/chat

WEBSOCKET_HEARTBEAT_SECONDS=20


# ============================================================
# DASHBOARD
# ============================================================

DEFAULT_SYMBOL=NIFTY
DEFAULT_TIMEFRAME=5m

OTM_CALL_COUNT=5
OTM_PUT_COUNT=5

DEFAULT_CANDLE_COUNT=500
MAX_CANDLES=2000


# ============================================================
# MARKET DATA
# ============================================================

MARKET_DATA_ENABLED=true


# ============================================================
# BROKER
# ============================================================

BROKER_NAME=5paisa
BROKER_ENVIRONMENT=development


# ============================================================
# TRADING
# ============================================================

# Phase 1: Orders disabled
TRADING_ENABLED=false
ORDERS_ENABLED=false


# ============================================================
# RISK CONTROL
# ============================================================

MAX_ORDER_QUANTITY=0
MAX_DAILY_ORDERS=0


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO


# ============================================================
# CORS
# ============================================================

CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
```
